{
  "name": "@vuepress/plugin-docsearch",
  "version": "2.0.0-rc.134",
  "description": "VuePress plugin - docsearch",
  "keywords": [
    "algolia",
    "docsearch",
    "plugin",
    "search",
    "vuepress",
    "vuepress-plugin"
  ],
  "homepage": "https://ecosystem.vuejs.press/plugins/search/docsearch.html",
  "bugs": {
    "url": "https://github.com/vuepress/ecosystem/issues"
  },
  "license": "MIT",
  "author": "meteorlxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuepress/ecosystem.git",
    "directory": "plugins/search/plugin-docsearch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./styles/*.css": "./dist/client/styles/*.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@docsearch/css": "^5.0.5",
    "@docsearch/js": "^5.0.5",
    "@vuepress/helper": "2.0.0-rc.134",
    "@vueuse/core": "^14.4.0",
    "ts-debounce": "^5.0.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@docsearch/react": "^5.0.5",
    "algoliasearch": "^5.57.0"
  },
  "peerDependencies": {
    "vuepress": "2.0.0-rc.31"
  },
  "gitHead": "938b80193c26fb617270f6d86729e52ee298da03"
}
